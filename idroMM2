-- idroMM2.lua — Прокачанное Ядро Thorium Engine v2.0
local Core = {
    Version = "2.0.0",
    Modules = {},
    Events = {},
    BaseURL = "https://raw.githubusercontent.com/musha9melnykmuhail-bot/1idro/refs/heads/main/ModuleUI"
}

local HttpService = game:GetService("HttpService")

-- 1. Глобальная система событий (Event Bus)
function Core.On(eventName, callback)
    Core.Events[eventName] = Core.Events[eventName] or {}
    table.insert(Core.Events[eventName], callback)
end

function Core.Emit(eventName, ...)
    if Core.Events[eventName] then
        for _, callback in ipairs(Core.Events[eventName]) do
            task.spawn(callback, ...)
        end
    end
end

-- 2. Универсальный загрузчик модулей
function Core.LoadModule(moduleIdentifier)
    local url = moduleIdentifier
    
    -- Если передали короткое имя (например "Visual"), автоматически подставляем BaseURL
    if not moduleIdentifier:find("http") then
        url = Core.BaseURL .. moduleIdentifier
    end

    -- Проверка на повторную загрузку
    if Core.Modules[moduleIdentifier] then
        return Core.Modules[moduleIdentifier]
    end

    -- Скачивание
    local fetchSuccess, scriptContent = pcall(function()
        return game:HttpGet(url)
    end)

    if not fetchSuccess or not scriptContent or scriptContent == "" then
        warn("[Thorium Core] Ошибка скачивания модуля: " .. tostring(moduleIdentifier))
        return nil
    end

    -- Компиляция
    local compileSuccess, moduleLoader = pcall(loadstring, scriptContent)
    if not compileSuccess or type(moduleLoader) ~= "function" then
        warn("[Thorium Core] Ошибка синтаксиса в модуле: " .. tostring(moduleIdentifier))
        return nil
    end

    -- Выполнение
    local execSuccess, moduleData = pcall(moduleLoader)
    if not execSuccess or type(moduleData) ~= "table" then
        warn("[Thorium Core] Модуль " .. tostring(moduleIdentifier) .. " не вернул таблицу!")
        return nil
    end

    -- Регистрация
    local moduleName = moduleData.Name or moduleIdentifier
    Core.Modules[moduleName] = moduleData

    -- Авто-инициализация
    if type(moduleData.Init) == "function" then
        local initSuccess, err = pcall(moduleData.Init, Core)
        if not initSuccess then
            warn("[Thorium Core] Ошибка в Init() у " .. moduleName .. ": " .. tostring(err))
        end
    end

    Core.Emit("ModuleLoaded", moduleName, moduleData)
    print("[Thorium Core] Модуль подгружен: " .. moduleName)
    return moduleData
end

-- 3. Выгрузка модуля
function Core.UnloadModule(moduleName)
    local module = Core.Modules[moduleName]
    if module then
        if type(module.Unload) == "function" then
            pcall(module.Unload)
        end
        Core.Modules[moduleName] = nil
        Core.Emit("ModuleUnloaded", moduleName)
        print("[Thorium Core] Модуль выгружен: " .. moduleName)
    end
end

-- 4. Система Сохранения / Загрузки Конфигов
function Core.SaveConfig(fileName, data)
    if writefile then
        local success, err = pcall(function()
            writefile(fileName .. ".json", HttpService:JSONEncode(data))
        end)
        if success then
            print("[Thorium Core] Конфиг сохранен: " .. fileName)
        end
    end
end

function Core.LoadConfig(fileName)
    if readfile and isfile and isfile(fileName .. ".json") then
        local success, result = pcall(function()
            return HttpService:JSONDecode(readfile(fileName .. ".json"))
        end)
        if success then
            return result
        end
    end
    return nil
end

print("[Thorium Core v2.0] Ядро успешно инициализировано!")
return Core
