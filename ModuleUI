-- Asset switch handling
local function SelectAsset(assetType)
    btnBaseAsset.BackgroundColor3 = (assetType == "Base") and ACCENT_PRIMARY or PANEL_BG
    btnBaseAsset.TextColor3 = (assetType == "Base") and Color3.fromRGB(255, 255, 255) or TEXT_SUB
    
    btnMurdAsset.BackgroundColor3 = (assetType == "Murder") and ACCENT_PRIMARY or PANEL_BG
    btnMurdAsset.TextColor3 = (assetType == "Murder") and Color3.fromRGB(255, 255, 255) or TEXT_SUB
    
    btnSherAsset.BackgroundColor3 = (assetType == "Sheriff") and ACCENT_PRIMARY or PANEL_BG
    btnSherAsset.TextColor3 = (assetType == "Sheriff") and Color3.fromRGB(255, 255, 255) or TEXT_SUB

    if assetType == "Base" then
        OverlayNameLabel.Text = "Target Player [Innocent]"
        OverlayWeaponLabel.Text = "[None]"
    elseif assetType == "Murder" then
        OverlayNameLabel.Text = "Target Player [Murderer]"
        OverlayWeaponLabel.Text = "[Knife]"
    elseif assetType == "Sheriff" then
        OverlayNameLabel.Text = "Target Player [Sheriff]"
        OverlayWeaponLabel.Text = "[Gun]"
    end
end

