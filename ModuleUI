-- ModuleUI.lua (Модуль Меню)
local UIModule = {
    Name = "ModuleUI",
    Version = "1.0.0",
    Enabled = true,
    CoreRef = nil,
    Tabs = {},
    Elements = {}
}

-- Метод инициализации (вызывается Ядром)
function UIModule.Init(Core)
    UIModule.CoreRef = Core
    print("[UI Module] Инициализация графического интерфейса...")

    -- Подписываемся на события загрузки других модулей
    Core.On("ModuleLoaded", function(name, moduleData)
        if name ~= UIModule.Name then
            print("[UI Module] Обнаружен новый модуль: " .. name .. ". Готов к интеграции UI.")
        end
    end)
end

-- Универсальный метод создания вкладок
function UIModule.CreateTab(tabName)
    if UIModule.Tabs[tabName] then
        return UIModule.Tabs[tabName]
    end

    local Tab = {
        Name = tabName,
        Controls = {}
    }

    -- Добавление переключателя (Toggle)
    function Tab:AddToggle(title, defaultState, callback)
        local ToggleData = {
            Type = "Toggle",
            Title = title,
            State = defaultState or false,
            Callback = callback
        }

        table.insert(Tab.Controls, ToggleData)
        print(string.format("[UI] [%s] Добавлен Toggle: %s (Состояние: %s)", tabName, title, tostring(ToggleData.State)))

        -- Здесь вызывается код вашей библиотека интерфейса (ScreenGui/Thorium UI)
        return {
            Set = function(self, newState)
                ToggleData.State = newState
                if callback then callback(newState) end
            end
        }
    end

    -- Добавление слайдера (Slider)
    function Tab:AddSlider(title, min, max, defaultVal, callback)
        local SliderData = {
            Type = "Slider",
            Title = title,
            Min = min,
            Max = max,
            Value = defaultVal or min,
            Callback = callback
        }

        table.insert(Tab.Controls, SliderData)
        print(string.format("[UI] [%s] Добавлен Slider: %s [%d..%d] (Значение: %d)", tabName, title, min, max, SliderData.Value))

        return {
            Set = function(self, newVal)
                SliderData.Value = newVal
                if callback then callback(newVal) end
            end
        }
    end

    UIModule.Tabs[tabName] = Tab
    return Tab
end

-- Переключение видимости интерфейса
function UIModule.Toggle(state)
    UIModule.Enabled = state
    print("[UI Module] Видимость интерфейса: " .. tostring(state))
    -- Код скрытия / отображения Gui
end

return UIModule
