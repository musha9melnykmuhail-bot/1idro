        subIconImg.Size = UDim2.new(0, 12, 0, 12)
        subIconImg.Position = UDim2.new(0, 24, 0.5, -6)
        subIconImg.BackgroundTransparency = 1
        subIconImg.Image = iconAsset
        subIconImg.ImageColor3 = TEXT_SUB
        subIconImg.Parent = subBtn
    end

    local subLbl = Instance.new("TextLabel")
    subLbl.Size = UDim2.new(1, iconAsset and -44 or -26, 1, 0)
    subLbl.Position = UDim2.new(0, iconAsset and 42 or 26, 0, 0)
    subLbl.BackgroundTransparency = 1
