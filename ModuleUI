-- ModuleUI.lua
local UIModule = {
    Name = "ModuleUI",
    Version = "1.0.0",
    Enabled = true,
    ScreenGui = nil,
    MainFrame = nil,
    TabContainer = nil,
    ContentContainer = nil,
    Tabs = {},
    ActiveTab = nil
}

local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")

function UIModule.CreateGui()
    if UIModule.ScreenGui then UIModule.ScreenGui:Destroy() end

    local screen = Instance.new("ScreenGui")
    screen.Name = "ThoriumUI_Core"
    screen.ResetOnSpawn = false
    
    if syn and syn.protect_gui then
        syn.protect_gui(screen)
        screen.Parent = CoreGui
    elseif gethui then
        screen.Parent = gethui()
    else
        screen.Parent = CoreGui
    end
    UIModule.ScreenGui = screen

    local main = Instance.new("Frame")
    main.Name = "MainFrame"
    main.Size = UDim2.new(0, 500, 0, 320)
    main.Position = UDim2.new(0.5, -250, 0.5, -160)
    main.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
    main.BorderSizePixel = 0
    main.Active = true
    main.Draggable = true
    main.Parent = screen

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 6)
    corner.Parent = main

    local title = Instance.new("TextLabel")
    title.Size = UDim2.new(1, -20, 0, 30)
    title.Position = UDim2.new(0, 10, 0, 5)
    title.Text = "THORIUM CORE"
    title.TextColor3 = Color3.fromRGB(255, 255, 255)
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.Font = Enum.Font.SourceSansBold
    title.TextSize = 16
    title.BackgroundTransparency = 1
    title.Parent = main

    local tabContainer = Instance.new("Frame")
    tabContainer.Size = UDim2.new(0, 120, 1, -45)
    tabContainer.Position = UDim2.new(0, 10, 0, 35)
    tabContainer.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
    tabContainer.BorderSizePixel = 0
    tabContainer.Parent = main

    local tabLayout = Instance.new("UIListLayout")
    tabLayout.Padding = UDim.new(0, 4)
    tabLayout.Parent = tabContainer

    UIModule.TabContainer = tabContainer

    local contentContainer = Instance.new("Frame")
    contentContainer.Size = UDim2.new(1, -150, 1, -45)
    contentContainer.Position = UDim2.new(0, 140, 0, 35)
    contentContainer.BackgroundColor3 = Color3.fromRGB(15, 15, 18)
    contentContainer.BorderSizePixel = 0
    contentContainer.Parent = main

    UIModule.ContentContainer = contentContainer
    UIModule.MainFrame = main

    UserInputService.InputBegan:Connect(function(input, gpe)
        if not gpe and input.KeyCode == Enum.KeyCode.Insert then
            UIModule.Toggle(not UIModule.Enabled)
        end
    end)
end

function UIModule.Init(Core)
    UIModule.CreateGui()
end

function UIModule.CreateTab(tabName)
    if UIModule.Tabs[tabName] then return UIModule.Tabs[tabName] end

    local tabBtn = Instance.new("TextButton")
    tabBtn.Size = UDim2.new(1, 0, 0, 30)
    tabBtn.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
    tabBtn.Text = tabName
    tabBtn.TextColor3 = Color3.fromRGB(180, 180, 180)
    tabBtn.Font = Enum.Font.SourceSans
    tabBtn.TextSize = 14
    tabBtn.Parent = UIModule.TabContainer

    local page = Instance.new("ScrollingFrame")
    page.Size = UDim2.new(1, -10, 1, -10)
    page.Position = UDim2.new(0, 5, 0, 5)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.ScrollBarThickness = 3
    page.Parent = UIModule.ContentContainer

    local pageLayout = Instance.new("UIListLayout")
    pageLayout.Padding = UDim.new(0, 6)
    pageLayout.Parent = page

    local Tab = { Page = page, Button = tabBtn }

    tabBtn.MouseButton1Click:Connect(function()
        for _, t in pairs(UIModule.Tabs) do
            t.Page.Visible = false
            t.Button.TextColor3 = Color3.fromRGB(180, 180, 180)
        end
        page.Visible = true
        tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end)

    if not UIModule.ActiveTab then
        UIModule.ActiveTab = Tab
        page.Visible = true
        tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    end

    function Tab:AddToggle(title, defaultState, callback)
        local toggleFrame = Instance.new("Frame")
        toggleFrame.Size = UDim2.new(1, 0, 0, 30)
        toggleFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 30)
        toggleFrame.Parent = page

        local label = Instance.new("TextLabel")
        label.Size = UDim2.new(1, -40, 1, 0)
        label.Position = UDim2.new(0, 10, 0, 0)
        label.Text = title
        label.TextColor3 = Color3.fromRGB(255, 255, 255)
        label.TextXAlignment = Enum.TextXAlignment.Left
        label.BackgroundTransparency = 1
        label.Font = Enum.Font.SourceSans
        label.TextSize = 14
        label.Parent = toggleFrame

        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 20, 0, 20)
        btn.Position = UDim2.new(1, -25, 0.5, -10)
        btn.Text = ""
        btn.BackgroundColor3 = defaultState and Color3.fromRGB(0, 170, 255) or Color3.fromRGB(50, 50, 60)
        btn.Parent = toggleFrame

        local state = defaultState or false
        btn.MouseButton1Click:Connect(function()
            state = not state
            btn.BackgroundColor3 = state and Color3.fromRGB(0, 170, 255) or Color3.fromRGB(50, 50, 60)
            if callback then callback(state) end
        end)
    end

    UIModule.Tabs[tabName] = Tab
    return Tab
end

function UIModule.Toggle(state)
    UIModule.Enabled = state
    if UIModule.MainFrame then
        UIModule.MainFrame.Visible = state
    end
end

return UIModule
