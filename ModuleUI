local elementMap = {}

local function CreateSettingsToggleRow(item)
    local Row = Instance.new("Frame")
    Row.Size = UDim2.new(1, 0, 0, 26)
    Row.BackgroundTransparency = 1
    Row.Parent = SettingsMenu

    local DragIcon = Instance.new("ImageLabel")
    DragIcon.Size = UDim2.new(0, 12, 0, 12)
    DragIcon.Position = UDim2.new(0, 2, 0.5, -6)
    DragIcon.BackgroundTransparency = 1
    DragIcon.Image = "rbxassetid://6031097225"
    DragIcon.ImageColor3 = TEXT_SUB
    DragIcon.Parent = Row

    local Label = Instance.new("TextLabel")
    Label.Size = UDim2.new(1, -50, 1, 0)
    Label.Position = UDim2.new(0, 20, 0, 0)
    Label.BackgroundTransparency = 1
    Label.Text = item.name
    Label.TextColor3 = TEXT_MAIN
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Font = Enum.Font.GothamMedium
    Label.TextSize = 10.5
    Label.Parent = Row

    local Switch = Instance.new("TextButton")
    Switch.Size = UDim2.new(0, 28, 0, 14)
    Switch.Position = UDim2.new(1, -28, 0.5, -7)
    Switch.BackgroundColor3 = item.enabled and ACCENT_PRIMARY or Color3.fromRGB(45, 36, 65)
    Switch.Text = ""
    Switch.Parent = Row
    Instance.new("UICorner", Switch).CornerRadius = UDim.new(1, 0)

    local Knob = Instance.new("Frame")
    Knob.Size = UDim2.new(0, 10, 0, 10)
    Knob.Position = item.enabled and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)
    Knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    Knob.Parent = Switch
    Instance.new("UICorner", Knob).CornerRadius = UDim.new(1, 0)

    Switch.MouseButton1Click:Connect(function()
        PlayClickSound()
        item.enabled = not item.enabled
        TweenService:Create(Switch, SMOOTH_TWEEN, {BackgroundColor3 = item.enabled and ACCENT_PRIMARY or Color3.fromRGB(45, 36, 65)}):Play()
        TweenService:Create(Knob, SMOOTH_TWEEN, {Position = item.enabled and UDim2.new(1, -12, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)}):Play()
        if elementMap[item.id] then
            elementMap[item.id].Visible = item.enabled
        end
    end)
end

for _, item in ipairs(WatermarkItems) do
