local function AddMainTab(tabName, iconAsset)
    local tabObj = {Name = tabName, SubTabs = {}}

    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, 0, 0, 34)
    btn.BackgroundColor3 = Color3.fromRGB(18, 14, 28)
    btn.BackgroundTransparency = 1
    btn.BorderSizePixel = 0
    btn.Text = ""
    btn.Parent = Sidebar

    local iconImg
    if iconAsset then
        iconImg = Instance.new("ImageLabel")
        iconImg.Name = "TabIcon"
        iconImg.Size = UDim2.new(0, 14, 0, 14)
        iconImg.Position = UDim2.new(0, 12, 0.5, -7)
        iconImg.BackgroundTransparency = 1
        iconImg.Image = iconAsset
        iconImg.ImageColor3 = TEXT_SUB
        iconImg.Parent = btn
        tabObj.IconImg = iconImg
    end

    local tabLbl = Instance.new("TextLabel")
    tabLbl.Size = UDim2.new(1, iconAsset and -34 or -16, 1, 0)
    tabLbl.Position = UDim2.new(0, iconAsset and 34 or 16, 0, 0)
    tabLbl.BackgroundTransparency = 1
    tabLbl.Text = tabName
    tabLbl.TextColor3 = TEXT_SUB
    tabLbl.Font = Enum.Font.GothamBold
    tabLbl.TextSize = 11
    tabLbl.TextXAlignment = Enum.TextXAlignment.Left
    tabLbl.Parent = btn
    tabObj.Btn = tabLbl

    local subContainer = Instance.new("Frame")
    subContainer.Size = UDim2.new(1, 0, 0, 0)
    subContainer.BackgroundTransparency = 1
    subContainer.ClipsDescendants = true
    subContainer.Parent = Sidebar
    
    local subLayout = Instance.new("UIListLayout")
    subLayout.SortOrder = Enum.SortOrder.LayoutOrder
    subLayout.Parent = subContainer

    tabObj.SubContainer = subContainer
    tabObj.Expanded = false

    btn.MouseButton1Click:Connect(function()
        PlayClickSound()
        for _, t in ipairs(TabsList) do
            if t ~= tabObj and t.Expanded then
                t.Expanded = false
                TweenService:Create(t.SubContainer, SMOOTH_TWEEN, {Size = UDim2.new(1, 0, 0, 0)}):Play()
            end
        end
        
        tabObj.Expanded = not tabObj.Expanded
        local targetHeight = tabObj.Expanded and (#tabObj.SubTabs * 26) or 0
        TweenService:Create(subContainer, SMOOTH_TWEEN, {Size = UDim2.new(1, 0, 0, targetHeight)}):Play()
        
        if tabObj.Expanded and #tabObj.SubTabs > 0 then
            HideAllPages()
            activePageRef = tabObj.SubTabs[1].PageObj
            tabObj.SubTabs[1].Page.Visible = true
            TweenService:Create(tabObj.Btn, SMOOTH_TWEEN, {TextColor3 = ACCENT_PRIMARY}):Play()
            if tabObj.IconImg then
                TweenService:Create(tabObj.IconImg, SMOOTH_TWEEN, {ImageColor3 = ACCENT_PRIMARY}):Play()
            end
            TweenService:Create(tabObj.SubTabs[1].Btn, SMOOTH_TWEEN, {TextColor3 = ACCENT_PRIMARY}):Play()
            if tabObj.SubTabs[1].IconImg then
                TweenService:Create(tabObj.SubTabs[1].IconImg, SMOOTH_TWEEN, {ImageColor3 = ACCENT_PRIMARY}):Play()
            end
            tabObj.SubTabs[1].Indicator.Visible = true
        end
    end)

    table.insert(TabsList, tabObj)
    return tabObj
end

local function AddSubTab(parentTab, subName, iconAsset)
    local subBtn = Instance.new("TextButton")
    subBtn.Size = UDim2.new(1, 0, 0, 26)
