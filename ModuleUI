    subLbl.Font = Enum.Font.GothamMedium
    subLbl.TextSize = 10
    subLbl.TextXAlignment = Enum.TextXAlignment.Left
    subLbl.Parent = subBtn

    local indicator = Instance.new("Frame")
    indicator.Size = UDim2.new(0, 3, 1, -10)
    indicator.Position = UDim2.new(0, 12, 0, 5)
    indicator.BackgroundColor3 = ACCENT_PRIMARY
    indicator.BorderSizePixel = 0
    indicator.Visible = false
    indicator.Parent = subBtn
    Instance.new("UICorner", indicator).CornerRadius = UDim.new(1, 0)

    local pageData = CreateContentPage(subName)
    local pageObj = BuildTabObj(pageData)

    local subObj = {Btn = subLbl, Page = pageData.Page, PageObj = pageObj, Indicator = indicator, IconImg = subIconImg}
    table.insert(parentTab.SubTabs, subObj)

    subBtn.MouseButton1Click:Connect(function()
        PlayClickSound()
        HideAllPages()
        activePageRef = pageObj
        pageData.Page.Visible = true
        
        TweenService:Create(parentTab.Btn, SMOOTH_TWEEN, {TextColor3 = ACCENT_PRIMARY}):Play()
