local Library = {
    Tabs = {},
    ActiveTab = nil
}

function Library:CreateTab(tabName, iconAsset)
    local tabObj = {
        Name = tabName,
        Sections = {},
        Page = nil,
        Btn = nil,
        Indicator = nil
    }

    -- Page Container
    local page = Instance.new("Frame")
    page.Name = tabName .. "Page"
    page.Size = UDim2.new(1, 0, 1, 0)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.Parent = ContentArea

    local leftCol = Instance.new("ScrollingFrame")
    leftCol.Size = UDim2.new(0.5, -12, 1, -16)
    leftCol.Position = UDim2.new(0, 8, 0, 8)
    leftCol.BackgroundTransparency = 1
    leftCol.ScrollBarThickness = 0
    leftCol.Parent = page

    local leftLayout = Instance.new("UIListLayout")
    leftLayout.SortOrder = Enum.SortOrder.LayoutOrder
    leftLayout.Padding = UDim.new(0, 8)
    leftLayout.Parent = leftCol
    leftLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        leftCol.CanvasSize = UDim2.new(0, 0, 0, leftLayout.AbsoluteContentSize.Y + 12)
    end)

    local rightCol = Instance.new("ScrollingFrame")
    rightCol.Size = UDim2.new(0.5, -12, 1, -16)
    rightCol.Position = UDim2.new(0.5, 4, 0, 8)
    rightCol.BackgroundTransparency = 1
    rightCol.ScrollBarThickness = 0
    rightCol.Parent = page

    local rightLayout = Instance.new("UIListLayout")
    rightLayout.SortOrder = Enum.SortOrder.LayoutOrder
    rightLayout.Padding = UDim.new(0, 8)
    rightLayout.Parent = rightCol
    rightLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        rightCol.CanvasSize = UDim2.new(0, 0, 0, rightLayout.AbsoluteContentSize.Y + 12)
    end)

    tabObj.Page = page
    tabObj.LeftCol = leftCol
    tabObj.RightCol = rightCol
    tabObj.ItemCounter = 0

    -- Sidebar Tab Button
    local tabBtn = Instance.new("TextButton")
    tabBtn.Size = UDim2.new(1, -12, 0, 32)
    tabBtn.Position = UDim2.new(0, 6, 0, 0)
    tabBtn.BackgroundColor3 = THEME.PANEL_BG
    tabBtn.BackgroundTransparency = 1
    tabBtn.Text = ""
    tabBtn.Parent = SidebarList

    Instance.new("UICorner", tabBtn).CornerRadius = UDim.new(0, 5)

    local indicator = Instance.new("Frame")
    indicator.Size = UDim2.new(0, 3, 0, 16)
    indicator.Position = UDim2.new(0, 0, 0.5, -8)
    indicator.BackgroundColor3 = THEME.ACCENT
    indicator.BorderSizePixel = 0
    indicator.BackgroundTransparency = 1
    indicator.Parent = tabBtn
    Instance.new("UICorner", indicator).CornerRadius = UDim.new(1, 0)

    local tabLbl = Instance.new("TextLabel")
    tabLbl.Size = UDim2.new(1, -30, 1, 0)
    tabLbl.Position = UDim2.new(0, 28, 0, 0)
    tabLbl.BackgroundTransparency = 1
    tabLbl.Text = tabName
    tabLbl.TextColor3 = THEME.TEXT_MUTED
    tabLbl.Font = Enum.Font.GothamMedium
    tabLbl.TextSize = 10.5
    tabLbl.TextXAlignment = Enum.TextXAlignment.Left
    tabLbl.Parent = tabBtn

    if iconAsset then
        local icon = Instance.new("ImageLabel")
        icon.Size = UDim2.new(0, 14, 0, 14)
        icon.Position = UDim2.new(0, 8, 0.5, -7)
        icon.BackgroundTransparency = 1
        icon.Image = iconAsset
        icon.ImageColor3 = THEME.TEXT_MUTED
        icon.Parent = tabBtn
        tabObj.Icon = icon
    end

    tabObj.Btn = tabBtn
    tabObj.Label = tabLbl
    tabObj.Indicator = indicator

    tabBtn.MouseButton1Click:Connect(function()
        PlayClickSound()
        for _, t in ipairs(Library.Tabs) do
            t.Page.Visible = false
            TweenService:Create(t.Btn, THEME.TWEEN_FAST, {BackgroundTransparency = 1}):Play()
            TweenService:Create(t.Label, THEME.TWEEN_FAST, {TextColor3 = THEME.TEXT_MUTED}):Play()
            TweenService:Create(t.Indicator, THEME.TWEEN_FAST, {BackgroundTransparency = 1}):Play()
            if t.Icon then
                TweenService:Create(t.Icon, THEME.TWEEN_FAST, {ImageColor3 = THEME.TEXT_MUTED}):Play()
            end
        end

        tabObj.Page.Visible = true
        TweenService:Create(tabBtn, THEME.TWEEN_FAST, {BackgroundTransparency = 0.8}):Play()
        TweenService:Create(tabLbl, THEME.TWEEN_FAST, {TextColor3 = THEME.TEXT_MAIN}):Play()
        TweenService:Create(indicator, THEME.TWEEN_FAST, {BackgroundTransparency = 0}):Play()
        if tabObj.Icon then
            TweenService:Create(tabObj.Icon, THEME.TWEEN_FAST, {ImageColor3 = THEME.ACCENT}):Play()
        end
        Library.ActiveTab = tabObj
    end)

    if #Library.Tabs == 0 then
        tabObj.Page.Visible = true
        tabBtn.BackgroundTransparency = 0.8
        tabLbl.TextColor3 = THEME.TEXT_MAIN
        indicator.BackgroundTransparency = 0
        if tabObj.Icon then tabObj.Icon.ImageColor3 = THEME.ACCENT end
        Library.ActiveTab = tabObj
    end

    table.insert(Library.Tabs, tabObj)

    -- SECTION CREATOR
    function tabObj:CreateSection(secName, side)
        local targetCol = (side == "Right") and tabObj.RightCol or tabObj.LeftCol

        local secFrame = Instance.new("Frame")
        secFrame.Name = secName .. "Section"
        secFrame.Size = UDim2.new(1, 0, 0, 32)
        secFrame.AutomaticSize = Enum.AutomaticSize.Y
        secFrame.BackgroundColor3 = THEME.PANEL_BG
        secFrame.BackgroundTransparency = 0.15
        secFrame.BorderSizePixel = 0
        secFrame.Parent = targetCol

        Instance.new("UICorner", secFrame).CornerRadius = UDim.new(0, 6)
        local secStroke = Instance.new("UIStroke")
        secStroke.Color = THEME.BORDER
        secStroke.Thickness = 1.2
        secStroke.Parent = secFrame

        local secTitle = Instance.new("TextLabel")
        secTitle.Size = UDim2.new(1, -16, 0, 26)
        secTitle.Position = UDim2.new(0, 10, 0, 2)
        secTitle.BackgroundTransparency = 1
        secTitle.Text = secName:upper()
        secTitle.TextColor3 = THEME.ACCENT
        secTitle.Font = Enum.Font.GothamBold
        secTitle.TextSize = 9.5
        secTitle.TextXAlignment = Enum.TextXAlignment.Left
        secTitle.Parent = secFrame

        local secContent = Instance.new("Frame")
        secContent.Name = "Container"
        secContent.Size = UDim2.new(1, -16, 0, 0)
        secContent.Position = UDim2.new(0, 8, 0, 28)
        secContent.AutomaticSize = Enum.AutomaticSize.Y
        secContent.BackgroundTransparency = 1
        secContent.Parent = secFrame

        local secLayout = Instance.new("UIListLayout")
        secLayout.SortOrder = Enum.SortOrder.LayoutOrder
        secLayout.Padding = UDim.new(0, 6)
        secLayout.Parent = secContent

        local secPadding = Instance.new("UIPadding")
        secPadding.PaddingBottom = UDim.new(0, 8)
        secPadding.Parent = secContent

        local SectionAPI = {}

        -- TOGGLE ELEMENT
        function SectionAPI:AddToggle(text, default, callback)
            local state = default or false

            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, 0, 0, 26)
            row.BackgroundTransparency = 1
            row.Parent = secContent

            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, -40, 1, 0)
            lbl.BackgroundTransparency = 1
            lbl.Text = text
            lbl.TextColor3 = THEME.TEXT_MAIN
            lbl.Font = Enum.Font.GothamMedium
            lbl.TextSize = 10
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Parent = row

            local switch = Instance.new("TextButton")
            switch.Size = UDim2.new(0, 30, 0, 15)
            switch.Position = UDim2.new(1, -30, 0.5, -7)
            switch.BackgroundColor3 = state and THEME.ACCENT or Color3.fromRGB(30, 40, 56)
            switch.Text = ""
            switch.Parent = row
            Instance.new("UICorner", switch).CornerRadius = UDim.new(1, 0)

            local knob = Instance.new("Frame")
            knob.Size = UDim2.new(0, 11, 0, 11)
            knob.Position = state and UDim2.new(1, -13, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)
            knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            knob.Parent = switch
            Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

            switch.MouseButton1Click:Connect(function()
                PlayClickSound()
                state = not state
                TweenService:Create(switch, THEME.TWEEN_FAST, {BackgroundColor3 = state and THEME.ACCENT or Color3.fromRGB(30, 40, 56)}):Play()
                TweenService:Create(knob, THEME.TWEEN_FAST, {Position = state and UDim2.new(1, -13, 0.5, -5) or UDim2.new(0, 2, 0.5, -5)}):Play()
                if callback then task.spawn(callback, state) end
            end)

            return row
        end

        -- SLIDER ELEMENT
        function SectionAPI:AddSlider(text, min, max, default, callback)
            local val = math.clamp(default or min, min, max)

            local row = Instance.new("Frame")
            row.Size = UDim2.new(1, 0, 0, 36)
            row.BackgroundTransparency = 1
            row.Parent = secContent

            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(0.7, 0, 0, 16)
            lbl.BackgroundTransparency = 1
            lbl.Text = text
            lbl.TextColor3 = THEME.TEXT_MAIN
            lbl.Font = Enum.Font.GothamMedium
            lbl.TextSize = 10
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Parent = row

            local valLbl = Instance.new("TextLabel")
            valLbl.Size = UDim2.new(0.3, 0, 0, 16)
            valLbl.Position = UDim2.new(0.7, 0, 0, 0)
            valLbl.BackgroundTransparency = 1
            valLbl.Text = tostring(val)
            valLbl.TextColor3 = THEME.ACCENT
            valLbl.Font = Enum.Font.GothamBold
            valLbl.TextSize = 10
            valLbl.TextXAlignment = Enum.TextXAlignment.Right
            valLbl.Parent = row

            local track = Instance.new("Frame")
            track.Size = UDim2.new(1, 0, 0, 4)
            track.Position = UDim2.new(0, 0, 1, -8)
            track.BackgroundColor3 = Color3.fromRGB(28, 38, 54)
            track.BorderSizePixel = 0
            track.Parent = row
            Instance.new("UICorner", track).CornerRadius = UDim.new(1, 0)

            local fill = Instance.new("Frame")
            fill.Size = UDim2.new((val - min)/(max - min), 0, 1, 0)
            fill.BackgroundColor3 = THEME.ACCENT
            fill.BorderSizePixel = 0
            fill.Parent = track
            Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

            local trigger = Instance.new("TextButton")
            trigger.Size = UDim2.new(1, 0, 1, 0)
            trigger.BackgroundTransparency = 1
            trigger.Text = ""
            trigger.Parent = row

            local draggingSlider = false
            local function updateSlider(input)
                local posX = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
                val = math.floor(min + (max - min) * posX)
                valLbl.Text = tostring(val)
                TweenService:Create(fill, THEME.TWEEN_FAST, {Size = UDim2.new(posX, 0, 1, 0)}):Play()
                if callback then task.spawn(callback, val) end
            end

            trigger.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    PlayClickSound()
                    draggingSlider = true
                    updateSlider(input)
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if draggingSlider and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                    updateSlider(input)
                end
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                    draggingSlider = false
                end
            end)

            return row
        end

        -- BUTTON ELEMENT
        function SectionAPI:AddButton(text, callback)
            local btn = Instance.new("TextButton")
            btn.Size = UDim2.new(1, 0, 0, 26)
            btn.BackgroundColor3 = THEME.PANEL_HOVER
            btn.Text = text
            btn.TextColor3 = THEME.TEXT_MAIN
            btn.Font = Enum.Font.GothamMedium
            btn.TextSize = 10
            btn.Parent = secContent

            Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 5)
            local btnStroke = Instance.new("UIStroke")
            btnStroke.Color = THEME.BORDER
            btnStroke.Thickness = 1
            btnStroke.Parent = btn

            btn.MouseButton1Click:Connect(function()
                PlayClickSound()
                TweenService:Create(btn, TweenInfo.new(0.08), {BackgroundColor3 = THEME.ACCENT}):Play()
                task.wait(0.08)
                TweenService:Create(btn, THEME.TWEEN_FAST, {BackgroundColor3 = THEME.PANEL_HOVER}):Play()
                if callback then task.spawn(callback) end
            end)

            return btn
        end

        -- DROPDOWN ELEMENT
        function SectionAPI:AddDropdown(text, options, default, callback)
            local selected = default or options[1] or ""
            local isOpen = false

            local container = Instance.new("Frame")
            container.Size = UDim2.new(1, 0, 0, 42)
            container.BackgroundTransparency = 1
            container.ClipsDescendants = true
            container.Parent = secContent

            local lbl = Instance.new("TextLabel")
            lbl.Size = UDim2.new(1, 0, 0, 14)
            lbl.BackgroundTransparency = 1
            lbl.Text = text
            lbl.TextColor3 = THEME.TEXT_MUTED
            lbl.Font = Enum.Font.GothamMedium
            lbl.TextSize = 9.5
            lbl.TextXAlignment = Enum.TextXAlignment.Left
            lbl.Parent = container

            local dropBox = Instance.new("TextButton")
            dropBox.Size = UDim2.new(1, 0, 0, 24)
            dropBox.Position = UDim2.new(0, 0, 0, 18)
            dropBox.BackgroundColor3 = THEME.PANEL_HOVER
            dropBox.Text = "  " .. tostring(selected)
            dropBox.TextColor3 = THEME.TEXT_MAIN
            dropBox.Font = Enum.Font.GothamMedium
            dropBox.TextSize = 10
            dropBox.TextXAlignment = Enum.TextXAlignment.Left
            dropBox.Parent = container

            Instance.new("UICorner", dropBox).CornerRadius = UDim.new(0, 5)

            local arrow = Instance.new("TextLabel")
            arrow.Size = UDim2.new(0, 20, 1, 0)
            arrow.Position = UDim2.new(1, -20, 0, 0)
            arrow.BackgroundTransparency = 1
            arrow.Text = "▼"
            arrow.TextColor3 = THEME.TEXT_MUTED
            arrow.Font = Enum.Font.GothamBold
            arrow.TextSize = 8
            arrow.Parent = dropBox

            local listFrame = Instance.new("Frame")
            listFrame.Size = UDim2.new(1, 0, 0, #options * 22)
            listFrame.Position = UDim2.new(0, 0, 0, 44)
            listFrame.BackgroundColor3 = Color3.fromRGB(18, 24, 34)
            listFrame.Parent = container
            Instance.new("UICorner", listFrame).CornerRadius = UDim.new(0, 5)

            local listLayout = Instance.new("UIListLayout")
            listLayout.SortOrder = Enum.SortOrder.LayoutOrder
            listLayout.Parent = listFrame

            for _, opt in ipairs(options) do
                local optBtn = Instance.new("TextButton")
                optBtn.Size = UDim2.new(1, 0, 0, 22)
                optBtn.BackgroundTransparency = 1
                optBtn.Text = "  " .. tostring(opt)
                optBtn.TextColor3 = (opt == selected) and THEME.ACCENT or THEME.TEXT_MAIN
                optBtn.Font = Enum.Font.GothamMedium
                optBtn.TextSize = 9.5
                optBtn.TextXAlignment = Enum.TextXAlignment.Left
                optBtn.Parent = listFrame

                optBtn.MouseButton1Click:Connect(function()
                    PlayClickSound()
                    selected = opt
                    dropBox.Text = "  " .. tostring(selected)
                    isOpen = false
                    TweenService:Create(container, THEME.TWEEN_FAST, {Size = UDim2.new(1, 0, 0, 42)}):Play()
                    if callback then task.spawn(callback, selected) end
                end)
            end

            dropBox.MouseButton1Click:Connect(function()
                PlayClickSound()
                isOpen = not isOpen
                local targetHeight = isOpen and (46 + #options * 22) or 42
                TweenService:Create(container, THEME.TWEEN_FAST, {Size = UDim2.new(1, 0, 0, targetHeight)}):Play()
            end)

            return container
        end

        return SectionAPI
    end

    return tabObj
end

