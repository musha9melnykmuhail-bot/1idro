-- ModuleUI.lua — Автономный UI в стиле Neverlose
local ModuleUI = {}
local CoreGui = game:GetService("CoreGui")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

-- Удаляем старое меню, если оно было открыто
if CoreGui:FindFirstChild("ThoriumNeverlose") then
    CoreGui.ThoriumNeverlose:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
ScreenGui.Name = "ThoriumNeverlose"
ScreenGui.ResetOnSpawn = false

-- Безопасная привязка к CoreGui
if gethui then
    ScreenGui.Parent = gethui()
elseif syn and syn.protect_gui then
    syn.protect_gui(ScreenGui)
    ScreenGui.Parent = CoreGui
else
    ScreenGui.Parent = CoreGui
end

-- Главное окно
local MainFrame = Instance.new("Frame")
MainFrame.Name = "MainFrame"
MainFrame.Size = UDim2.new(0, 560, 0, 360)
MainFrame.Position = UDim2.new(0.5, -280, 0.5, -180)
MainFrame.BackgroundColor3 = Color3.fromRGB(11, 14, 20)
MainFrame.BorderSizePixel = 0
MainFrame.Active = true
MainFrame.Draggable = true
MainFrame.Parent = ScreenGui

local MainCorner = Instance.new("UICorner")
MainCorner.CornerRadius = UDim.new(0, 10)
MainCorner.Parent = MainFrame

-- Боковая панель
local Sidebar = Instance.new("Frame")
Sidebar.Size = UDim2.new(0, 140, 1, 0)
Sidebar.BackgroundColor3 = Color3.fromRGB(8, 10, 15)
Sidebar.BorderSizePixel = 0
Sidebar.Parent = MainFrame

local SideCorner = Instance.new("UICorner")
SideCorner.CornerRadius = UDim.new(0, 10)
SideCorner.Parent = Sidebar

local Logo = Instance.new("TextLabel")
Logo.Text = "THORIUM"
Logo.Size = UDim2.new(1, 0, 0, 45)
Logo.BackgroundTransparency = 1
Logo.TextColor3 = Color3.fromRGB(0, 180, 255)
Logo.Font = Enum.Font.GothamBold
Logo.TextSize = 16
Logo.Parent = Sidebar

local TabHolder = Instance.new("Frame")
TabHolder.Size = UDim2.new(1, -16, 1, -55)
TabHolder.Position = UDim2.new(0, 8, 0, 50)
TabHolder.BackgroundTransparency = 1
TabHolder.Parent = Sidebar

local TabList = Instance.new("UIListLayout")
TabList.SortOrder = Enum.SortOrder.LayoutOrder
TabList.Padding = UDim.new(0, 6)
TabList.Parent = TabHolder

-- Контейнер для страниц
local PageHolder = Instance.new("Frame")
PageHolder.Size = UDim2.new(1, -155, 1, -20)
PageHolder.Position = UDim2.new(0, 148, 0, 10)
PageHolder.BackgroundTransparency = 1
PageHolder.Parent = MainFrame

local FirstTab = true

function ModuleUI.CreateTab(tabName)
    local Page = Instance.new("ScrollingFrame")
    Page.Size = UDim2.new(1, 0, 1, 0)
    Page.BackgroundTransparency = 1
    Page.BorderSizePixel = 0
    Page.ScrollBarThickness = 2
    Page.ScrollBarImageColor3 = Color3.fromRGB(0, 180, 255)
    Page.Visible = FirstTab
    Page.Parent = PageHolder

    local PageList = Instance.new("UIListLayout")
    PageList.SortOrder = Enum.SortOrder.LayoutOrder
    PageList.Padding = UDim.new(0, 8)
    PageList.Parent = Page

    local TabBtn = Instance.new("TextButton")
    TabBtn.Size = UDim2.new(1, 0, 0, 32)
    TabBtn.BackgroundColor3 = FirstTab and Color3.fromRGB(15, 22, 32) or Color3.fromRGB(11, 14, 20)
    TabBtn.Text = "  " .. tabName
    TabBtn.TextColor3 = FirstTab and Color3.fromRGB(0, 180, 255) or Color3.fromRGB(120, 130, 145)
    TabBtn.Font = Enum.Font.GothamMedium
    TabBtn.TextSize = 13
    TabBtn.TextXAlignment = Enum.TextXAlignment.Left
    TabBtn.Parent = TabHolder

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 8)
    BtnCorner.Parent = TabBtn

    TabBtn.MouseButton1Click:Connect(function()
        for _, p in pairs(PageHolder:GetChildren()) do
            if p:IsA("ScrollingFrame") then
                p.Visible = false
            end
        end
        for _, b in pairs(TabHolder:GetChildren()) do
            if b:IsA("TextButton") then
                b.BackgroundColor3 = Color3.fromRGB(11, 14, 20)
                b.TextColor3 = Color3.fromRGB(120, 130, 145)
            end
        end
        Page.Visible = true
        TabBtn.BackgroundColor3 = Color3.fromRGB(15, 22, 32)
        TabBtn.TextColor3 = Color3.fromRGB(0, 180, 255)
    end)

    FirstTab = false

    local TabApi = {}

    function TabApi:AddToggle(text, default, callback)
        local Enabled = default or false

        local ToggleFrame = Instance.new("Frame")
        ToggleFrame.Size = UDim2.new(1, -8, 0, 36)
        ToggleFrame.BackgroundColor3 = Color3.fromRGB(14, 18, 26)
        ToggleFrame.BorderSizePixel = 0
        ToggleFrame.Parent = Page

        local ToggleCorner = Instance.new("UICorner")
        ToggleCorner.CornerRadius = UDim.new(0, 8)
        ToggleCorner.Parent = ToggleFrame

        local Label = Instance.new("TextLabel")
        Label.Text = "  " .. text
        Label.Size = UDim2.new(0.7, 0, 1, 0)
        Label.BackgroundTransparency = 1
        Label.TextColor3 = Color3.fromRGB(200, 210, 225)
        Label.TextXAlignment = Enum.TextXAlignment.Left
        Label.Font = Enum.Font.Gotham
        Label.TextSize = 13
        Label.Parent = ToggleFrame

        local Switch = Instance.new("Frame")
        Switch.Size = UDim2.new(0, 34, 0, 18)
        Switch.Position = UDim2.new(1, -42, 0.5, -9)
        Switch.BackgroundColor3 = Enabled and Color3.fromRGB(0, 180, 255) or Color3.fromRGB(25, 32, 45)
        Switch.Parent = ToggleFrame

        local SwitchCorner = Instance.new("UICorner")
        SwitchCorner.CornerRadius = UDim.new(1, 0)
        SwitchCorner.Parent = Switch

        local Dot = Instance.new("Frame")
        Dot.Size = UDim2.new(0, 14, 0, 14)
        Dot.Position = Enabled and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
        Dot.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        Dot.Parent = Switch

        local DotCorner = Instance.new("UICorner")
        DotCorner.CornerRadius = UDim.new(1, 0)
        DotCorner.Parent = Dot

        local Btn = Instance.new("TextButton")
        Btn.Size = UDim2.new(1, 0, 1, 0)
        Btn.BackgroundTransparency = 1
        Btn.Text = ""
        Btn.Parent = ToggleFrame

        Btn.MouseButton1Click:Connect(function()
            Enabled = not Enabled
            
            -- Анимация переключателя
            TweenService:Create(Switch, TweenInfo.new(0.15), {
                BackgroundColor3 = Enabled and Color3.fromRGB(0, 180, 255) or Color3.fromRGB(25, 32, 45)
            }):Play()
            
            TweenService:Create(Dot, TweenInfo.new(0.15), {
                Position = Enabled and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
            }):Play()

            if callback then
                callback(Enabled)
            end
        end)
    end

    return TabApi
end

-- Переключение отображения по клавише Insert
UserInputService.InputBegan:Connect(function(input, gpe)
    if not gpe and input.KeyCode == Enum.KeyCode.Insert then
        MainFrame.Visible = not MainFrame.Visible
    end
end)

return ModuleUI
