-- Render — Связка со стильными секциями
local ModuleUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/musha9melnykmuhail-bot/1idro/refs/heads/main/ModuleUI"))()

if not ModuleUI then return end

-- 1. Вкладка COMBAT
local CombatTab = ModuleUI.CreateTab("Combat")
local MainCombat = CombatTab:CreateSection("Aimbot Settings")
MainCombat:AddToggle("Enable Aimbot", false, function(s) print("Aimbot:", s) end)
MainCombat:AddToggle("Silent Aim", false, function(s) print("Silent:", s) end)
MainCombat:AddToggle("Wall Check", true, function(s) print("WallCheck:", s) end)

local TargetSec = CombatTab:CreateSection("Targeting")
TargetSec:AddToggle("Draw FOV Circle", false, function(s) print("FOV:", s) end)
TargetSec:AddToggle("Target Lock", false, function(s) print("Lock:", s) end)

-- 2. Вкладка VISUALS
local VisualTab = ModuleUI.CreateTab("Visuals")
local ESPMain = VisualTab:CreateSection("Player ESP")
ESPMain:AddToggle("Box ESP", false, function(s) print("Box:", s) end)
ESPMain:AddToggle("Chams Highlight", false, function(s) print("Chams:", s) end)
ESPMain:AddToggle("Tracers", false, function(s) print("Tracers:", s) end)

local ESPInfo = VisualTab:CreateSection("Extra Information")
ESPInfo:AddToggle("Display Names", false, function(s) print("Names:", s) end)
ESPInfo:AddToggle("Health Bar", false, function(s) print("Health:", s) end)
ESPInfo:AddToggle("Distance", false, function(s) print("Distance:", s) end)

print("[Thorium UI] Запущено в стиле Neverlose!")
