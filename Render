-- Render — Связующий лоадер для Thorium
local ModuleUI = loadstring(game:HttpGet("https://raw.githubusercontent.com/musha9melnykmuhail-bot/1idro/refs/heads/main/ModuleUI"))()

if not ModuleUI then
    return warn("[Thorium] Ошибка: Не удалось загрузить ModuleUI!")
end

print("[Thorium] Инициализация интерфейса...")

-- 1. Создаем вкладку Combat
local CombatTab = ModuleUI.CreateTab("Combat")
CombatTab:AddToggle("Aimbot (Hold RMB)", false, function(state)
    print("Aimbot:", state)
end)
CombatTab:AddToggle("Silent Aim", false, function(state)
    print("Silent Aim:", state)
end)
CombatTab:AddToggle("Draw FOV Circle", false, function(state)
    print("FOV Circle:", state)
end)
CombatTab:AddToggle("Wall Check", false, function(state)
    print("Wall Check:", state)
end)

-- 2. Создаем вкладку Visuals
local VisualTab = ModuleUI.CreateTab("Visuals")
VisualTab:AddToggle("Box ESP", false, function(state)
    print("Box ESP:", state)
end)
VisualTab:AddToggle("Chams Highlight", false, function(state)
    print("Chams Highlight:", state)
end)
VisualTab:AddToggle("Tracers", false, function(state)
    print("Tracers:", state)
end)
VisualTab:AddToggle("Player Names", false, function(state)
    print("Player Names:", state)
end)
VisualTab:AddToggle("Health Bar", false, function(state)
    print("Health Bar:", state)
end)

print("[Thorium] Меню успешно открыто! Нажмите INSERT для скрытия/показа.")
